# --- Core -------------------------------------------------------------------
# Public origin of the site (no trailing slash). Staging: your Hostinger temp URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local: docker compose Postgres, always. Staging/production: Neon pooled string
# (sslmode=require), set in Hostinger env vars only. Pointing local dev at Neon
# lets Payload's dev schema-push alter that database outside migrations.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/handymandoit

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Media: Cloudflare R2 (leave S3_BUCKET empty to store uploads on local disk) ---
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL or custom domain, e.g. https://media.handymandoit.com
MEDIA_PUBLIC_URL=

# --- Email (leave SMTP_HOST empty to log emails to the console) ---------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=handymanservicesdoit@gmail.com

# --- Tests (optional) --------------------------------------------------------
# Port for the Playwright web server; change it to run e2e beside another server.
# E2E_PORT=3000
# Test a deployed site instead of starting one (npm run test:smoke), e.g. staging.
# E2E_BASE_URL=https://staging.example
# Use the installed Google Chrome when Playwright's Chromium is not downloaded.
# E2E_CHANNEL=chrome
